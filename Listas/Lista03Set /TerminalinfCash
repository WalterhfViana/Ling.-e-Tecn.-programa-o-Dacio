#include <stdio.h>
#include <stdlib.h>
int main(){
    /* exercicio 05 */
    int cem,cinquenta,dez,cinco,dois,um;
    float Valor,ValorTotal;
    printf("Valor: ");
    scanf("%f",&Valor);
    ValorTotal=Valor;
    cem = (Valor / 100); if (cem>0)printf("\nNotas de R$100: %d",cem); Valor = Valor-(cem*100);
    cinquenta = (Valor / 50); if (cinquenta>0)printf("\nNotas de R$50: %d",cinquenta); Valor = Valor-(cinquenta*50);
    dez =(Valor / 10); if (dez>0)printf("\nNotas de R$10: %d",dez); Valor = Valor-(dez*10);
    cinco =(Valor / 5); if (cinco>0)printf("\nNotas de R$5: %d",cinco); Valor = Valor-(cinco*5);
    dois =(Valor / 2); if (dois>0)printf("\nNotas de R$2: %d",dois); Valor = Valor-(dois*2);
    um=(Valor/1); if (um>0)printf("\nMoedas de R$1: %d",um); Valor = Valor-(um*1);
    printf("\nValor Total: R$%.2f",ValorTotal);
    return 0;
}
